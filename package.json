{
  "name": "tech-radar",
  "version": "1.0.0",
  "description": "Générateur de site statique Tech Radar basé sur Markdown",
  "author": "Yoan Thirion",
  "type": "module",
  "scripts": {
    "build": "tsx build.ts",
    "validate": "tsx build.ts --validate-only",
    "dev": "tsx build.ts && npx serve dist -p 3000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "esbuild": "0.25.0",
    "gray-matter": "^4.0.3",
    "marked": "^12.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5"
  }
}
